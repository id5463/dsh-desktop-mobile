{
    "name":  "dshd-red",
    "version":  "1.0.0",
    "description":  "dshd Red - native desktop GUI for DeepSeek Harness (dshd family, desktop variant)",
    "main":  "src/main.js",
    "scripts":  {
                    "start":  "electron .",
                    "build:win":  "electron-builder --win --x64",
                    "build:linux":  "electron-builder --linux",
                    "build:mac":  "electron-builder --mac",
                    "dist":  "electron-builder --win --x64 --config build.config.json"
                },
    "build":  {
                  "appId":  "com.dshd.red",
                  "productName":  "dshd Red",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "src/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "assets/icon.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true
                           }
              },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs"
}
